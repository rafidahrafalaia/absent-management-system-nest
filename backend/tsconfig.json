{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node",
      "multer"
    ],
    "paths": {
      "@app/common": [
        "./libs/common/src/index.ts"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/employee-service/tsconfig.app.json"
    },
    {
      "path": "./apps/admin-service/tsconfig.app.json"
    },
    {
      "path": "./apps/logging-service/tsconfig.app.json"
    },
    {
      "path": "./libs/common/tsconfig.lib.json"
    }
  ]
}