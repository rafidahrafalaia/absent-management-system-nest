# --- Shared ---------------------------------------------------------------
# Same secret in every service so a token issued by one is accepted by the others.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
APP_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- MySQL ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rahasia
# HR database (users, attendances) used by employee-service and admin-service
DB_NAME=absensi
# Separate database used only by logging-service (activity_logs, devices)
LOGGING_DB_NAME=absensi_logging
# Auto-create/alter tables from the entities. Use migrations instead in production.
DB_SYNCHRONIZE=true

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=activity_logs

# --- Ports ----------------------------------------------------------------
EMPLOYEE_SERVICE_PORT=3002
ADMIN_SERVICE_PORT=3003
LOGGING_SERVICE_PORT=4000

# --- Uploads (shared by employee-service and admin-service) ----------------
UPLOAD_DIR=uploads

# --- First admin account, created by admin-service if no admin exists -------
ADMIN_NAME=HR Admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123

# --- Optional: Firebase Cloud Messaging push (SSE popups work without it) ----
# Path to a Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=
