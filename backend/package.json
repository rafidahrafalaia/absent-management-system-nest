{
  "name": "absensi-backend",
  "version": "0.0.1",
  "description": "Absensi WFH microservices (NestJS): employee, admin and logging services",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build employee-service && nest build admin-service && nest build logging-service",
    "start:employee": "nest start employee-service --watch",
    "start:admin": "nest start admin-service --watch",
    "start:logging": "nest start logging-service --watch",
    "start:prod:employee": "node dist/apps/employee-service/main.js",
    "start:prod:admin": "node dist/apps/admin-service/main.js",
    "start:prod:logging": "node dist/apps/logging-service/main.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint --type-aware apps/ libs/",
    "test": "vitest run",
    "typecheck": "tsc -p apps/employee-service/tsconfig.app.json --noEmit && tsc -p apps/admin-service/tsconfig.app.json --noEmit && tsc -p apps/logging-service/tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.5.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
